<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.showcase.pay.order.mapper.OrderMapper">

    <!-- Result Map -->
    <resultMap id="BaseResultMap" type="com.showcase.pay.order.entity.Order">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="amount" property="amount"/>
        <result column="currency" property="currency"/>
        <result column="status" property="status"/>
        <result column="subject" property="subject"/>
        <result column="description" property="description"/>
        <result column="pay_time" property="payTime"/>
        <result column="expire_time" property="expireTime"/>
        <result column="extra_data" property="extraData"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- Base Column List -->
    <sql id="Base_Column_List">
        id, order_no, user_id, amount, currency, status, subject, description,
        pay_time, expire_time, extra_data, create_time, update_time,
        create_by, update_by, deleted
    </sql>

    <!-- Select by order number -->
    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM orders
        WHERE order_no = #{orderNo}
        AND deleted = 0
    </select>

    <!-- Select by user ID with pagination -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM orders
        WHERE user_id = #{userId}
        AND deleted = 0
        ORDER BY create_time DESC
    </select>

    <!-- Select expired orders that are not paid -->
    <select id="selectExpiredUnpaidOrders" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM orders
        WHERE status IN ('CREATED', 'PENDING_PAYMENT')
        AND expire_time &lt; #{currentTime}
        AND deleted = 0
        ORDER BY create_time ASC
    </select>

    <!-- Batch update order status -->
    <update id="batchUpdateStatus">
        UPDATE orders
        SET status = #{status},
            update_time = NOW()
        WHERE id IN
        <foreach collection="orderIds" item="orderId" open="(" separator="," close=")">
            #{orderId}
        </foreach>
        AND deleted = 0
    </update>

</mapper>
