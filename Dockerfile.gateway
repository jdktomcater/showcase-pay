# ============================================
# Dockerfile for Gateway Service
# ============================================
# Note: Using Ubuntu-based image (not alpine) for arm64/M1/M2 support
FROM eclipse-temurin:17-jre

LABEL maintainer="showcase-pay-team"

# Environment variables
ENV JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"
ENV TZ=Asia/Shanghai
ENV SERVER_PORT=8080
ENV SW_AGENT_NAME=showcase-pay-gateway
ENV SW_AGENT_COLLECTOR_BACKEND_SERVICES=skywalking-oap:11800
ENV SW_AGENT_AUTHENTICATION=
ENV SKYWALKING_VERSION=9.7.0

# Set working directory
WORKDIR /app

# Install Skywalking Java Agent
RUN apt-get update && apt-get install -y wget && \
    wget -q https://archive.apache.org/dist/skywalking/java-agent/${SW_AGENT_VERSION}/apache-skywalking-java-agent-${SW_AGENT_VERSION}.tgz -O /tmp/skywalking-agent.tgz && \
    tar -xzf /tmp/skywalking-agent.tgz -C /opt && \
    mv /opt/apache-skywalking-java-agent /opt/skywalking-agent && \
    rm /tmp/skywalking-agent.tgz && \
    apt-get remove -y wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Configure Skywalking Agent
RUN sed -i 's/agent.service_name=.*/agent.service_name=${SW_AGENT_NAME}/' /opt/skywalking-agent/agent/config/agent.config && \
    sed -i 's/collector.backend_service=.*/collector.backend_service=${SW_AGENT_COLLECTOR_BACKEND_SERVICES}/' /opt/skywalking-agent/agent/config/agent.config

# Add JAR file
ARG JAR_FILE=target/*.jar
COPY ${JAR_FILE} app.jar

# Expose port
EXPOSE ${SERVER_PORT}

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=30s \
  CMD wget --quiet --tries=1 --spider http://localhost:${SERVER_PORT}/actuator/health || exit 1

# Entry point with Skywalking Agent
ENTRYPOINT ["sh", "-c", "java -javaagent:/opt/skywalking-agent/skywalking-agent.jar ${JAVA_OPTS} -Djava.security.egd=file:/dev/./urandom -jar app.jar"]
